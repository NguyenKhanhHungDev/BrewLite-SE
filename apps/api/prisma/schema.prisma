generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id       Int    @id @default(autoincrement())
  name     String
  price    Int
  imageUrl String
  stock    Int
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
}